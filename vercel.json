{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js", 
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api-docs/:path*", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}